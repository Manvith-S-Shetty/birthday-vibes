# Supabase Configuration (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Server-Only - DO NOT EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Auth & Cryptographic Secrets (Server-Only - DO NOT EXPOSE TO CLIENT)
APP_AUTH_SECRET=your-random-32-byte-secret-key-here
PIN_HASH_SECRET_SALT=your-random-salt-string-here

# Next.js App URL (Optional, defaults to request host / Vercel URL)
NEXT_PUBLIC_APP_URL=https://your-domain.com
